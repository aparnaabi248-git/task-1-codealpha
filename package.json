{
  "name": "codealpha-devops-task1-azure-cicd",
  "version": "1.0.0",
  "description": "Automated CI/CD Pipeline for Web Application using Azure DevOps, Docker, ACR, and Azure App Service",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "jest --ci --reporters=default --reporters=jest-junit",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "devops",
    "azure-devops",
    "ci-cd",
    "docker",
    "acr",
    "azure-app-service",
    "codealpha"
  ],
  "author": "CodeAlpha DevOps Intern",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "./test-results",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
